# Copy this file to .env before running docker compose up --build -d.
# Replace this sample with your own strong LOCAL DEVELOPMENT password.
# Use letters, numbers and ! or _ to avoid connection-string escaping issues.
MSSQL_SA_PASSWORD=LocalDev_ChangeMe_2026!
SQL_PORT=14330
API_PORT=5080

# Generated by scripts/Setup-LocalHttps.ps1; needed for the optional HTTPS API container.
HTTPS_CERT_PASSWORD=

# Required only when running the optional API container; SQL-only startup does not use it.
Security__ApiKey=
